                  "protocolProfileBehavior": {
                    "disableBodyPruning": true
                  },
                  "request": {
                    "method": "POST",
                    "header": [
                      {
                        "key": "Content-Type",
                        "value": "application/x-www-form-urlencoded"
                      },
                      {
                        "key": "Accept",
                        "value": "application/json"
                      }
                    ],
                    "body": {
                      "mode": "urlencoded",
                      "urlencoded": [
                        {
                          "description": "(Required) The OAuth 2.0 grant type. Use authorization_code for initial token requests and refresh_token to renew expired tokens.",
                          "key": "grant_type",
                          "value": "refresh_token"
                        },
                        {
                          "description": "(Required) The client identifier issued during API client registration in Workday.",
                          "key": "client_id",
                          "value": "<string>"
                        },
                        {
                          "description": "(Required) The client secret issued during API client registration.",
                          "key": "client_secret",
                          "value": "<string>"
                        },
                        {
                          "description": "The authorization code received from the authorization endpoint. Required when grant_type is authorization_code.",
                          "key": "code",
                          "value": "<string>"
                        },
                        {
                          "description": "The redirect URI registered with the API client. Required when grant_type is authorization_code.",
                          "key": "redirect_uri",
                          "value": "<uri>"
                        },
                        {
                          "description": "The refresh token issued during a previous token request. Required when grant_type is refresh_token.",
                          "key": "refresh_token",
                          "value": "<string>"
                        }
                      ]
                    },
                    "url": {
                      "raw": "{{baseUrl}}/oauth2/:tenant/token",
                      "host": [
                        "{{baseUrl}}"
                      ],
                      "path": [
                        "oauth2",
                        ":tenant",
                        "token"
                      ],
                      "variable": [
                        {
                          "id": "a747cff3-8763-46e7-9cfc-f2c2ec17b5d1",
                          "key": "tenant",
                          "value": "<string>",
                          "description": "(Required) Workday tenant identifier"
                        }
                      ]
                    },
                    "description": "Exchange an authorization code or refresh token for a new access token. The token endpoint accepts client credentials and either an authorization code or refresh token to issue a new bearer token for authenticating subsequent REST API requests."
