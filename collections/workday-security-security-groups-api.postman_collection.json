  "info": {
    "_postman_id": "1ef84adb-553b-4057-b5a9-35127f54507a",
    "name": "Workday Security Workday Audit and Compliance Account Signons Security Groups API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Access audit logs, security reports, and compliance data within the Workday platform. Provides programmatic access to audit trail information for security monitoring, regulatory compliance, and governance reporting. Supports retrieval of configuration change history, security policy modifications, and access control audit records for maintaining a complete compliance trail.\n\nContact Support:\n Name: Workday Support\n Email: support@workday.com",
      "type": "text/plain"
    }
  }
