  "item": [
    {
      "id": "20e666c3-311a-452b-aa60-71e833d82da8",
      "name": "OAuth Tokens",
      "description": {
        "content": "Obtain and manage OAuth 2.0 access tokens for authenticating REST API requests to Workday services.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "c606a4a4-ccfe-4330-9b2a-bccb97c66f2d",
          "name": "Workday Security Request an OAuth 2.0 access token",
          "request": {
            "name": "Workday Security Request an OAuth 2.0 access token",
            "description": {
              "content": "Exchange an authorization code or refresh token for a new access token. The token endpoint accepts client credentials and either an authorization code or refresh token to issue a new bearer token for authenticating subsequent REST API requests.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "oauth2",
                ":tenant",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "{{tenant}}",
                  "key": "tenant",
                  "description": "Workday tenant identifier"
                },
                {
                  "description": "Workday host for your tenant environment",
                  "type": "any",
                  "value": "{{host}}",
                  "key": "host"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) The OAuth 2.0 grant type. Use authorization_code for initial token requests and refresh_token to renew expired tokens."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) The client identifier issued during API client registration in Workday."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<string>",
                  "description": "(Required) The client secret issued during API client registration."
                },
                {
                  "disabled": false,
                  "key": "code",
                  "value": "<string>",
                  "description": "The authorization code received from the authorization endpoint. Required when grant_type is authorization_code."
                },
                {
                  "disabled": false,
                  "key": "redirect_uri",
                  "value": "<uri>",
                  "description": "The redirect URI registered with the API client. Required when grant_type is authorization_code."
                },
                {
                  "disabled": false,
                  "key": "refresh_token",
                  "value": "<string>",
                  "description": "The refresh token issued during a previous token request. Required when grant_type is refresh_token."
                }
              ]
            }
          },
